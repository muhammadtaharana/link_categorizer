{
  "performance": {
    "parallel_jobs": 4,
    "batch_size": 1000,
    "cache_enabled": true,
    "progress_indicator": true
  },
  "output": {
    "formats": ["txt", "json", "html"],
    "include_statistics": true,
    "include_timestamps": true
  },
  "http_validation": {
    "enabled": false,
    "timeout_seconds": 5,
    "max_retries": 2,
    "verify_ssl": true
  },
  "database": {
    "enabled": false,
    "type": "sqlite",
    "path": "./categorizer.db",
    "retention_days": 30
  },
  "webhooks": {
    "slack_url": "",
    "jira_url": "",
    "custom_url": "",
    "send_on_completion": false,
    "send_on_error": false
  },
  "patterns": {
    "custom_categories": [],
    "exclude_extensions": ["jpg", "jpeg", "png", "gif", "css", "woff", "woff2", "ttf", "ico", "svg"],
    "case_sensitive": false
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "file": "./categorizer.log",
    "max_size_mb": 10,
    "retention_days": 7
  },
  "integrations": {
    "burp_suite": {
      "enabled": false,
      "export_format": "csv"
    },
    "nuclei": {
      "enabled": false,
      "severity_filter": "high,critical"
    },
    "sqlmap": {
      "enabled": false,
      "batch_mode": true
    }
  }
}
